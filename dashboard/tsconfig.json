{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "index.ts",
    "types.ts",
    "components/**/*.ts",
    "utils/**/*.ts",
    "tests/**/*.ts"
  ]
}
